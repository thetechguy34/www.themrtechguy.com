{
  "name": "tmtco-main-site",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "252a6494ae754649a12ba38d642cec25"
    }
  ],

  "vars": {
    "TENANT_ID": "f1011f75-0d96-4d08-b8d4-6c79c851f9ba",
    "CLIENT_ID": "db8b6556-cec8-4b83-94b1-364cefd24203",
    "BASE_URL": "https://www.tmtcoau.com"
  }

  // CLIENT_SECRET must remain a Secret set in the Cloudflare dashboard
  // (Workers & Pages -> your worker -> Settings -> Variables & Secrets)
  // Never put the client secret in this file.
{
  // ...
  "observability": {
    "enabled": false
  },
  // ...
}
}
